# Local Docker PostgreSQL settings. Replace the placeholder password in .env.
POSTGRES_DB=maximor
POSTGRES_USER=maximor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=55432

# Used by the Python application running on the host.
MAXIMOR_DATABASE_URL=postgresql+asyncpg://maximor:change-me-local-only@localhost:55432/maximor
MAXIMOR_DATABASE_ECHO=false

# API, local object storage, and worker smoke-test settings.
MAXIMOR_API_HOST=127.0.0.1
MAXIMOR_API_PORT=8000
MAXIMOR_MAX_PDF_UPLOAD_BYTES=10485760
MAXIMOR_LOCAL_STORAGE_ROOT=src/.runtime/documents
MAXIMOR_WORKER_POLL_INTERVAL_SECONDS=1.0
MAXIMOR_WORKER_IDENTITY=local-worker

# Future DocumentAnalysisAgent configuration. Set ANTHROPIC_API_KEY only in local .env.
ANTHROPIC_API_KEY=
DOCUMENT_ANALYSIS_MODEL=claude-sonnet-5
MAXIMOR_DOCUMENT_ANALYSIS_MAX_TURNS=12
MAXIMOR_DOCUMENT_ANALYSIS_MAX_THINKING_TOKENS=4096
MAXIMOR_DOCUMENT_ANALYSIS_TIMEOUT_SECONDS=120
MAXIMOR_DOCUMENT_ANALYSIS_MAX_CORRECTIONS=1
# MAXIMOR_DOCUMENT_ANALYSIS_MAX_BUDGET_USD=1.00

# Future SkuMappingAgent configuration. Reuses the same ANTHROPIC_API_KEY above.
SKU_MAPPING_MODEL=claude-sonnet-5
MAXIMOR_SKU_MAPPING_MAX_TURNS=8
MAXIMOR_SKU_MAPPING_MAX_THINKING_TOKENS=2048
MAXIMOR_SKU_MAPPING_TIMEOUT_SECONDS=60
MAXIMOR_SKU_MAPPING_MAX_CORRECTIONS=1
# MAXIMOR_SKU_MAPPING_MAX_BUDGET_USD=1.00

# TermTriageAgent configuration.
TERM_TRIAGE_MODEL=claude-sonnet-5
MAXIMOR_TERM_TRIAGE_MAX_TURNS=4
MAXIMOR_TERM_TRIAGE_MAX_THINKING_TOKENS=1024
MAXIMOR_TERM_TRIAGE_TIMEOUT_SECONDS=60
MAXIMOR_TERM_TRIAGE_MAX_CORRECTIONS=1
# MAXIMOR_TERM_TRIAGE_MAX_BUDGET_USD=1.00

# TermApplicabilityAgent configuration.
TERM_APPLICABILITY_MODEL=claude-sonnet-5
MAXIMOR_TERM_APPLICABILITY_MAX_TURNS=8
MAXIMOR_TERM_APPLICABILITY_MAX_THINKING_TOKENS=2048
MAXIMOR_TERM_APPLICABILITY_TIMEOUT_SECONDS=150
MAXIMOR_TERM_APPLICABILITY_MAX_CORRECTIONS=1
# MAXIMOR_TERM_APPLICABILITY_MAX_BUDGET_USD=1.00
MAXIMOR_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
